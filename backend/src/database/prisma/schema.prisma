generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Scan {
  id          String     @id @default(cuid())
  url         String
  status      ScanStatus @default(PENDING)
  config      Json       @default("{}")
  createdAt   DateTime   @default(now())
  completedAt DateTime?

  issues Issue[]

  @@index([status])
  @@index([createdAt])
}

model Issue {
  id          String        @id @default(cuid())
  scanId      String
  type        IssueType
  severity    IssueSeverity
  url         String
  sourceUrl   String?
  description String
  metadata    Json?
  createdAt   DateTime      @default(now())

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
  @@index([type])
  @@index([severity])
}

enum ScanStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum IssueType {
  BROKEN_RESOURCE
  FAILED_API
  INTERACTIVITY
  EMPTY_CONTENT
  LAZY_LOAD
  FORM_MODAL
}

enum IssueSeverity {
  HIGH
  MEDIUM
  LOW
}
