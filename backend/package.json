{
  "name": "sitesentry-qa-backend",
  "version": "1.0.0",
  "description": "Backend API para SiteSentry QA - Análisis automatizado de calidad web",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "dev:worker": "tsx watch src/workers/start.ts",
    "build": "tsc",
    "start": "node dist/api/server.js",
    "start:worker": "node dist/workers/start.js",
    "prisma:generate": "prisma generate --schema=src/database/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=src/database/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=src/database/prisma/schema.prisma",
    "test": "echo \"Tests pendientes de implementar\""
  },
  "keywords": [
    "qa",
    "crawling",
    "web-analysis",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@prisma/client": "^5.7.1",
    "bullmq": "^5.1.9",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.40.1",
    "pngjs": "^7.0.0",
    "sharp": "^0.34.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.5",
    "@types/pngjs": "^6.0.5",
    "prisma": "^5.7.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
